# PostgreSQL Connection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mydb
POSTGRES_USER=backup_user
POSTGRES_PASSWORD=backup_secret
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_secret

# Yandex.Disk
# Obtain OAuth token with cloud_api:disk.write and cloud_api:disk.read scopes at https://oauth.yandex.com/
YANDEX_TOKEN=
YANDEX_BACKUP_FOLDER=/backups/pg-yandex-backup

# Telegram Notifications (optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Backup Settings
DEBOUNCE_SECONDS=60
BACKUP_CRON=0 3 * * *
LOCAL_BACKUP_DIR=/backups
RETENTION_DAYS=30
MIN_KEEP_BACKUPS=5
# Minimum free space required on Yandex.Disk before starting upload (in bytes, default: 500 MB)
MIN_FREE_BYTES=524288000
